# Upravlja Ansible (rola app). Sadrzi lozinku baze — zato 0600 i van Gita.
# Vrijednosti dolaze iz group_vars (plan adresiranja) i ~/.ruo/db-password.

DB_NAME=notes
DB_USER=notes
DB_PASSWORD={{ app_db_password | trim }}

DB_HOST={{ app_db_host }}
DB_PORT=5432

BACKEND_URL={{ app_backend_url }}
FRONTEND_PORT={{ frontend_port }}

WEB_DNS={{ app_web_dns }}
DATA_DNS={{ app_data_dns }}

WEB_SUBNET={{ app_web_subnet }}
DATA_SUBNET={{ app_data_subnet }}
FRONTEND_IP={{ frontend_ip }}
BACKEND_IP={{ backend1_ip }}
BACKEND_DATA_IP={{ backend1_data_ip }}
DB_IP={{ db_ip }}
