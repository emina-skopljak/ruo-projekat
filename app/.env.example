# Primjer konfiguracije. Stvarni .env se pravi lokalno i NIKAD ne ide u Git.
#   cp .env.example .env
#
# U VM-u ove vrijednosti ne popunjava covjek, nego Ansible (iz ansible-vault-a
# i plana adresiranja). Zato su imena ista u oba okruzenja.

# --- baza ---
DB_NAME=notes
DB_USER=notes
DB_PASSWORD=promijeni-me

# --- backend ---
DB_HOST=db
DB_PORT=5432

# --- frontend ---
# Lokalno: ime servisa. U VM-u: DNS ime iz BIND zone (npr. http://api.oblak.local:8000)
BACKEND_URL=http://backend:8000
FRONTEND_PORT=8080

# --- plan adresiranja (DO-3) ---
# Fiksne adrese su potrebne da bi BIND zona imala stabilne A zapise (AO-7, AO-8).
WEB_SUBNET=172.28.10.0/24
DATA_SUBNET=172.28.20.0/24
FRONTEND_IP=172.28.10.10
BACKEND_WEB_IP=172.28.10.20
BACKEND_DATA_IP=172.28.20.20
DB_IP=172.28.20.30
