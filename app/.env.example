# Primjer konfiguracije. Stvarni .env pravi Ansible iz ovih vrijednosti
# (group_vars + ~/.ruo/db-password) i on NIKAD ne ide u Git.
#
# Lokalno pokretanje bez VM-a: promijeni DB_HOST=db i
# BACKEND_URL=http://backend:8000, jer tada nema BIND zone.

# --- baza ---
DB_NAME=notes
DB_USER=notes
DB_PASSWORD=promijeni-me

# --- backend ---
# AO-7: puno ime iz zone projekta, nikad IP
DB_HOST=db.ruo.local
DB_PORT=5432

# --- frontend ---
BACKEND_URL=http://api.ruo.local:8000
FRONTEND_PORT=8080

# --- DNS serveri za kontejnere (gateway adrese Docker mreza na VM-u) ---
WEB_DNS=172.28.10.1
DATA_DNS=172.28.20.1

# --- plan adresiranja (DO-3) ---
WEB_SUBNET=172.28.10.0/24
DATA_SUBNET=172.28.20.0/24
FRONTEND_IP=172.28.10.10
BACKEND_IP=172.28.10.20
BACKEND_DATA_IP=172.28.20.20
DB_IP=172.28.20.30
